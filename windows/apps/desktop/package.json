{
  "name": "@cbct/desktop",
  "version": "1.0.3",
  "author": {
    "name": "Lee"
  },
  "private": true,
  "description": "v2 Electron 壳：负责 Go server 生命周期与本地 token 注入，不含业务逻辑",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "package:windows": "electron-builder --win nsis --x64 --publish never",
    "test": "npm run build && node --experimental-sqlite --test test/update-status.test.cjs test/icon-resources.test.cjs test/launcher.test.cjs test/backup.test.cjs"
  },
  "devDependencies": {
    "@cbct/shared": "0.0.0",
    "@types/node": "^22.0.0",
    "electron": "44.2.0",
    "typescript": "~5.9.2"
  },
  "build": {
    "appId": "com.readx.desktop",
    "productName": "ReadX",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../../release"
    },
    "artifactName": "ReadX-Setup-${version}.${ext}",
    "files": [
      "dist/**",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/bin/server.exe",
        "to": "server/bin/server.exe"
      },
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../../.release-staging/resources",
        "to": "."
      },
      {
        "from": "../../.release-staging/resources/node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReadX"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Leechion",
        "repo": "ReadX",
        "releaseType": "draft"
      }
    ],
    "protocols": [
      {
        "name": "ReadX browser capture",
        "schemes": [
          "readx-capture"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  }
}
